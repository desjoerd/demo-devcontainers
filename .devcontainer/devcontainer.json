{
	"name": "Aspire",
	"image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
	"features": {
		"ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3.1.0": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
		"ghcr.io/devcontainers/features/node:2.1.2": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "os-provided"
		},
		"ghcr.io/devcontainers-extra/features/uv:1": {},
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "10.0"
		},
		"ghcr.io/devcontainers/features/powershell:2.0.4": {}
	},
	"hostRequirements": {
		"cpus": 8,
		"memory": "32gb",
		"storage": "64gb"
	},
	"remoteEnv": {
		"SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust"
	},
	"postStartCommand": "aspire certs trust --non-interactive",
	"customizations": {
		"vscode": {
			"extensions": [
				"microsoft-aspire.aspire-vscode",
				"GitHub.copilot-chat",
				"dbaeumer.vscode-eslint",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-dotnettools.csdevkit"
			]
		}
	}
}